<Window x:Class="ReelApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reel"
        Height="760"
        Width="1180"
        WindowStyle="None"
        AllowsTransparency="True"
        WindowStartupLocation="CenterScreen"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        FontFamily="Segoe UI"
        Foreground="White">

    <!-- Fundo Gradiente Midnight Neon -->
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0"
                EndPoint="0,1">
            <GradientStop Color="#0f172a"
                    Offset="0.0"/>
            <GradientStop Color="#050508"
                    Offset="1.0"/>
        </LinearGradientBrush>
    </Window.Background>

    <!-- Permite arrastar e redimensionar a janela nativamente -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52"
                ResizeBorderThickness="5"
                GlassFrameThickness="0"
                CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- BARRA LATERAL -->
        <Border Grid.Column="0"
                Background="#0AFFFFFF"
                BorderBrush="#15FFFFFF"
                BorderThickness="0,0,1,0">
            <Grid Margin="18,28,18,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo -->
                <StackPanel Orientation="Horizontal"
                        Grid.Row="0"
                        Margin="0,0,0,30">
                    <Border Width="34"
                            Height="34"
                            Background="#00F0FF"
                            CornerRadius="10">
                        <TextBlock Text="↓"
                                FontSize="20"
                                FontWeight="Bold"
                                Foreground="Black"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Reel"
                            FontSize="18"
                            FontWeight="Bold"
                            Foreground="White"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Menu -->
                <StackPanel Grid.Row="1">
                    <Button Content="Download"
                            Height="40"
                            Background="#1A00F0FF"
                            Foreground="#00F0FF"
                            BorderBrush="#8000F0FF"
                            BorderThickness="1"
                            FontWeight="SemiBold"
                            HorizontalContentAlignment="Left"
                            Padding="15,0,0,0"
                            Margin="0,0,0,10">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius"
                                        Value="9"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button Content="Histórico"
                            Height="40"
                            Background="Transparent"
                            Foreground="#94a3b8"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            HorizontalContentAlignment="Left"
                            Padding="15,0,0,0"/>
                </StackPanel>

                <!-- Versão -->
                <TextBlock Grid.Row="3"
                        Text="v2.0 (C# Edition)"
                        Foreground="#475569"
                        FontSize="11"
                        Margin="10,0,0,0"/>
            </Grid>
        </Border>

        <!-- ÁREA PRINCIPAL -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Botões de Controle da Janela -->
            <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    WindowChrome.IsHitTestVisibleInChrome="True"
                    Margin="0,0,10,0">
                <Button Content="—"
                        Width="36"
                        Height="36"
                        Background="Transparent"
                        Foreground="#94a3b8"
                        BorderThickness="0"
                        Click="BtnMinimize_Click"/>
                <Button Content="□"
                        Width="36"
                        Height="36"
                        Background="Transparent"
                        Foreground="#94a3b8"
                        BorderThickness="0"
                        Click="BtnMaximize_Click"/>
                <Button Content="✕"
                        Width="36"
                        Height="36"
                        Background="Transparent"
                        Foreground="#94a3b8"
                        BorderThickness="0"
                        Click="BtnClose_Click"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="40,10,40,40">

                    <!-- PASSO 1: URL -->
                    <Border Background="#0CFFFFFF"
                            BorderBrush="#20FFFFFF"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="28,26"
                            Margin="0,0,0,20">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="50"
                                    Color="Black"
                                    Opacity="0.4"
                                    ShadowDepth="15"/>
                        </Border.Effect>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,15">
                                <Border Width="26"
                                        Height="26"
                                        BorderBrush="#4000F0FF"
                                        BorderThickness="1"
                                        CornerRadius="13">
                                    <TextBlock Text="1"
                                            Foreground="#00F0FF"
                                            FontWeight="Bold"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Cole o link do vídeo"
                                        Foreground="White"
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center"/>
                            </StackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtUrl"
                                        Grid.Column="0"
                                        Background="#20000000"
                                        Foreground="White"
                                        BorderBrush="#30FFFFFF"
                                        BorderThickness="1"
                                        Height="50"
                                        Padding="15,0"
                                        VerticalContentAlignment="Center"
                                        FontSize="14"
                                        Margin="0,0,10,0"/>
                                <Button x:Name="BtnBaixar"
                                        Click="BtnBaixar_Click"
                                        Grid.Column="1"
                                        Content="Baixar"
                                        Background="#00F0FF"
                                        Foreground="Black"
                                        FontWeight="Bold"
                                        Width="120"
                                        Height="50"
                                        BorderThickness="0"
                                        Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius"
                                                    Value="12"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </Grid>

                            <TextBlock x:Name="TxtStatus"
                                    Text="Aguardando link..."
                                    Foreground="#94a3b8"
                                    Margin="5,15,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- PASSO 2: OPÇÕES -->
                    <Border Background="#0CFFFFFF"
                            BorderBrush="#20FFFFFF"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="28,26"
                            Margin="0,0,0,20">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,15">
                                <Border Width="26"
                                        Height="26"
                                        BorderBrush="#4000F0FF"
                                        BorderThickness="1"
                                        CornerRadius="13">
                                    <TextBlock Text="2"
                                            Foreground="#00F0FF"
                                            FontWeight="Bold"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Opções de download"
                                        Foreground="White"
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center"/>
                            </StackPanel>

                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0"
                                        Margin="0,0,10,0">
                                    <TextBlock Text="TIPO"
                                            Foreground="#94a3b8"
                                            FontSize="11"
                                            Margin="0,0,0,5"/>
                                    <ComboBox x:Name="CmbTipo"
                                            Height="45"
                                            SelectedIndex="0"
                                            Background="#11000000"
                                            Foreground="Black">
                                        <ComboBoxItem Content="Vídeo"/>
                                        <ComboBoxItem Content="Áudio"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="1"
                                        Margin="10,0,10,0">
                                    <TextBlock Text="FORMATO"
                                            Foreground="#94a3b8"
                                            FontSize="11"
                                            Margin="0,0,0,5"/>
                                    <ComboBox x:Name="CmbFormato"
                                            Height="45"
                                            SelectedIndex="0"
                                            Background="#11000000"
                                            Foreground="Black">
                                        <ComboBoxItem Content="MP4"/>
                                        <ComboBoxItem Content="WEBM"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="2"
                                        Margin="10,0,0,0">
                                    <TextBlock Text="QUALIDADE"
                                            Foreground="#94a3b8"
                                            FontSize="11"
                                            Margin="0,0,0,5"/>
                                    <ComboBox x:Name="CmbQualidade"
                                            Height="45"
                                            SelectedIndex="0"
                                            Background="#11000000"
                                            Foreground="Black">
                                        <ComboBoxItem Content="Full HD / 1080p"/>
                                        <ComboBoxItem Content="4K / 2160p"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="RECORTE (ARRASTE PARA AJUSTAR)"
                                    Foreground="#94a3b8"
                                    FontSize="11"
                                    Margin="0,0,0,5"/>
                            <Slider Margin="0,0,0,20"
                                    Minimum="0"
                                    Maximum="100"
                                    Value="0"/>

                            <CheckBox Content="Baixar playlist completa"
                                    Foreground="#94a3b8"/>
                        </StackPanel>
                    </Border>

                    <!-- PASSO 3: PRÉVIA -->
                    <Border Background="#0CFFFFFF"
                            BorderBrush="#20FFFFFF"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="28,26">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,15">
                                <Border Width="26"
                                        Height="26"
                                        BorderBrush="#4000F0FF"
                                        BorderThickness="1"
                                        CornerRadius="13">
                                    <TextBlock Text="3"
                                            Foreground="#00F0FF"
                                            FontWeight="Bold"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Prévia"
                                        Foreground="White"
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <!-- Placeholder da Imagem (Preto opaco) -->
                                <Border Width="240"
                                        Height="135"
                                        Background="#151515"
                                        BorderBrush="#30FFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Margin="0,0,20,0">
                                    <TextBlock Text="[ Vídeo ]"
                                            Foreground="#475569"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Aguardando link..."
                                            Foreground="White"
                                            FontSize="18"
                                            FontWeight="SemiBold"
                                            Margin="0,0,0,8"/>
                                    <TextBlock Text="Cole um link acima para ver as informações do vídeo."
                                            Foreground="#94a3b8"
                                            FontSize="13"
                                            TextWrapping="Wrap"
                                            MaxWidth="400"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>